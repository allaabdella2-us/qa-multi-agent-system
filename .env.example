# Jira credentials for `tracker: jira`. Copy to .env and fill in.
# .env is gitignored — the token must never be committed.
#
# The token is an API token, NOT your Atlassian password. Create one at:
#   https://id.atlassian.com/manage-profile/security/api-tokens

export JIRA_BASE_URL="https://YOUR-SITE.atlassian.net"
export JIRA_EMAIL="you@example.com"
export JIRA_API_TOKEN="paste-the-api-token-here"
export JIRA_PROJECT_KEY="ABC"

# Optional. If unset, security findings go to JIRA_PROJECT_KEY above —
# see the routing note before filing anything.
# export JIRA_SECURITY_PROJECT_KEY="SEC"

# Optional. Must be an issue type your project actually has. Default: Bug
# export JIRA_ISSUE_TYPE="Bug"
